{
  "name": "@reflexionia/domain",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./recurrence": {
      "types": "./dist/recurrence/index.d.ts",
      "default": "./dist/recurrence/index.js"
    },
    "./filters": {
      "types": "./dist/filters/index.d.ts",
      "default": "./dist/filters/index.js"
    },
    "./nlp": {
      "types": "./dist/nlp/index.d.ts",
      "default": "./dist/nlp/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "rrule": "^2.8.1",
    "date-fns-tz": "^3.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "9.17.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
