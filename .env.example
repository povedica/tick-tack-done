# NO pongas secretos reales aquí; copia a `.env` (ignorado por git).
# Los ejemplos fallan a propósito si NODE_ENV=production.
# Local defaults match docker-compose.dev.yml. Change them before any shared or production deploy.
POSTGRES_USER=reflexionia
POSTGRES_PASSWORD=dev
POSTGRES_DB=reflexionia
DATABASE_URL=postgresql://reflexionia:dev@localhost:5432/reflexionia

# --- Redis (bus de eventos BullMQ, cola de recordatorios, caché) ---
REDIS_URL=redis://localhost:6379

# --- API ---
# Commit que devuelve GET /api/v1/health. El script de producción lo rellena al construir.
GIT_COMMIT=dev
NODE_ENV=development
PORT=3000
# dev resolves the caller from X-Dev-User-Email and grants the scopes the route declares.
# A bearer PAT does not inherit that pass: it can only do what its scopes allow.
AUTH_MODE=dev
# Producción: el compose fuerza AUTH_MODE vacío. No desplegar con dev.
# true publica el outbox en BullMQ. En producción el compose lo activa.
BUS_AUTOSTART=false
# The API process runs the scheduler. Set false to leave occurrences and reminders unsent.
SCHEDULER_AUTOSTART=true
# Correo entrante público: peticiones por IP cada 15 min.
INBOUND_RATE_LIMIT=30
# Solo CI y tests locales. Ausente en producción: NODE_ENV=production lo rechaza.
# El límite real del PAT sigue siendo 1000 peticiones cada 15 minutos.
# TOKEN_RATE_LIMIT_TEST=
# true deja el registro abierto después del primer usuario.
REGISTRATION_OPEN=false
ATTACHMENT_MAX_BYTES=26214400
PUBLIC_URL=https://todo.example.com
# Secreto para firmar sesiones y PATs: generar con `openssl rand -hex 32`
APP_SECRET=change-me-openssl-rand-hex-32
# Cifrado de TOTP, refresh de Google y secretos de webhook. 32 bytes en hex.
DATA_ENCRYPTION_KEY=
# Saltos de X-Forwarded-For de confianza. En el compose de producción es 1 (solo Caddy
# delante de la API). Debe coincidir exactamente con la topología: un valor bajo hace
# que todos compartan el bucket del proxy; uno alto permite falsificar X-Forwarded-For.
TRUST_PROXY_HOPS=1
# Límites de intentos en 15 minutos (S-01). OAuth usa un bucket aparte del login/TOTP.
# AUTH_IP_LIMIT=10
# AUTH_OAUTH_IP_LIMIT=60
# AUTH_FAILURE_LIMIT=5
# AUTH_REGISTER_LIMIT=5
# true solo en un laboratorio: permite webhooks http.
ALLOW_HTTP_WEBHOOKS=false
# true publica Swagger en producción. Por defecto está apagado.
ENABLE_API_DOCS=false

# --- Email transaccional (SMTP). En local, Mailpit escucha en 1025 y la UI en http://localhost:8025 ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=todo@example.com

# --- Web Push (VAPID): generar con `pnpm --filter web exec web-push generate-vapid-keys` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:todo@example.com

# --- Backups (RF-1704). AGE_RECIPIENT es la clave pública age; sin ella no se sube el backup. ---
BACKUP_DIR=./backups
AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30
# Destino rclone. Si está vacío y GOOGLE_DRIVE_FOLDER_ID tiene valor, el backup se sube a esa carpeta.
BACKUP_REMOTE=

# --- Integraciones. Vacío = el corte arranca y el endpoint responde *_not_configured. No inventar secretos. ---
# Telegram se configura por usuario desde Ajustes → Integraciones; no usa credenciales globales.
# URL que recibe el audio (POST, application/octet-stream) y responde {"text":"..."}.
TELEGRAM_VOICE_PROVIDER=
# Origen de los enlaces que el bot manda al teléfono. En local: http://127.0.0.1:5173
APP_WEB_URL=

# --- Ticky BFF (all effect flags default off). Private key PEM is never committed. ---
TICKY_SERVICE_URL=
TICKY_JWT_PRIVATE_KEY_PEM=
TICKY_JWT_KID=
TICKY_JWT_ISS=tick-tack-done
TICKY_UI_ENABLED=false
TICKY_READ_ENABLED=false
TICKY_MODEL_ENABLED=false
TICKY_EXECUTION_ENABLED=false
TICKY_ROUTINES_ENABLED=false
TICKY_TELEGRAM_ENABLED=false
TICKY_KILL_SWITCH=false
# Identidad de la aplicación en Google Cloud. El refresh token lo pide la propia aplicación.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=

# --- Seed de desarrollo (pnpm db:seed). No usar estos valores fuera de local. ---
SEED_USER_EMAIL=demo@reflexionia.test
SEED_USER_PASSWORD=dev-only

# --- Web ---
VITE_API_URL=http://127.0.0.1:3000/api/v1

# Google Picker: public browser configuration; restrict this API key by origin/API in Google Cloud.
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
# Direct web upload limit; REST/email/Telegram remain capped at 25 MiB.
DRIVE_ATTACHMENT_MAX_BYTES=104857600
# Email transaccional por Resend; tiene prioridad sobre SMTP cuando hay API key.
# Seleccionar staging explícitamente con RUNTIME_ENV_FILE=/ruta/absoluta/staging.env.
RESEND_API_KEY=
EMAIL_FROM=
STAGING_TEST_EMAIL=
