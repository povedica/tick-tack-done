// Section 5 of the spec. Column names stay snake_case via @map.
// Every tenant row hangs from an owner (decision D5).
// search_vector is a generated tsvector (FTS on title + content).
// The partial due_date index and the one-inbox unique index live in the
// initial migration because Prisma 6 cannot model their predicates.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum TaskKind {
  task
  note
}

enum TaskStatus {
  active
  completed
  archived
  cancelled
}

enum PlanSessionState {
  draft
  applying
  applied
  discarded
}

enum PlanSessionKind {
  plan
  shutdown
  replan
}

enum PlanDecisionKind {
  done
  plan_day
  later
  cancel
  trash
  skip
  someday
}

enum Priority {
  none
  low
  medium
  high
}

enum RepeatFrom {
  due_date
  completion_date
}

enum TaskSource {
  mcp
  manual
  import
  api
  automation
  plugin
}

enum ChecklistStatus {
  active
  completed
}

enum ProjectViewMode {
  list
  kanban
  timeline
}

enum ProjectKind {
  TASK
  NOTE
}

enum FilterMode {
  normal
  advanced
}

enum ReminderType {
  relative
  absolute
  location
  daily_digest
}

enum ReminderChannel {
  push
  email
  both
}

enum ReminderDeliveryStatus {
  scheduled
  fired
  late
  failed
  cancelled
}

enum ReminderDeliveryKind {
  focus_end
  habit
  task
  daily_digest
  shutdown_digest
  overdue
  due_soon
  countdown
}

enum CountdownType {
  countdown
  anniversary
  birthday
  holiday
}

enum CountdownDayMode {
  standard
  plus_one
}

enum CountdownRepeat {
  none
  daily
  weekly
  monthly
  yearly
}

enum FocusSessionType {
  stopwatch
  focus
  short_break
  long_break
}

enum CalendarSyncDirection {
  read
  two_way
}

enum ActivityAction {
  created
  updated
  completed
  deleted
  assigned
  commented
  accessed
}

enum SharePermission {
  read
  comment
  write
}

enum MatrixQuadrant {
  do
  schedule
  delegate
  drop
}

enum WebhookDeliveryState {
  pending
  delivered
  failed
  gave_up
}

enum AutomationRunState {
  ok
  error
}

enum Theme {
  light
  dark
  auto
}

enum WeekStart {
  monday
  sunday
}

enum SmartListKey {
  today
  tomorrow
  next_7_days
  all
  inbox
  assigned_to_me
  completed
  trash
  no_date
  recently_added
  someday
}

enum CompleteChildrenPolicy {
  ask
  complete
  leave
}

model ViewPreference {
  ownerId String @map("owner_id") @db.Uuid
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  key String
  preferences Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@id([ownerId, key])
  @@map("view_preferences")
}

model User {
  viewPreferences ViewPreference[]
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  passwordHash          String?                @map("password_hash")
  displayName           String                 @map("display_name")
  avatar                String?
  timeZone              String                 @default("Europe/Madrid") @map("time_zone")
  locale                String                 @default("es")
  weekStart             WeekStart              @default(monday) @map("week_start")
  dateFormat            String                 @default("dd/MM/yyyy") @map("date_format")
  theme                 Theme                  @default(auto)
  nlpLanguage            String                 @default("es") @map("nlp_language")
  density                String                 @default("comfortable")
  accent                 String                 @default("indigo")
  defaultReminderTrigger String?                @map("default_reminder_trigger")
  inboundEmailTokenHash  String?                @unique @map("inbound_email_token_hash")
  dailyReminderTime     String?                @map("daily_reminder_time")
  quietHoursStart       String?                @map("quiet_hours_start")
  quietHoursDays        Int[]                  @default([0, 1, 2, 3, 4, 5, 6]) @map("quiet_hours_days")
  quietAllowHigh        Boolean                @default(false) @map("quiet_allow_high")
  quietHoursEnd         String?                @map("quiet_hours_end")
  telegramEnabled       Boolean                @default(true) @map("telegram_enabled")
  focusNotifications    Boolean                @default(true) @map("focus_notifications")
  featureFlags          Json                   @default("{}") @map("feature_flags")
  weeklyReportSettings  Json                   @default("{}") @map("weekly_report_settings")
  shutdownReminderTime  String?                @map("shutdown_reminder_time")
  workDayStart          String?                @default("09:00") @map("work_day_start")
  workDayEnd            String?                @default("18:00") @map("work_day_end")
  defaultTaskDuration   Int                    @default(30) @map("default_task_duration")
  deadlineSoonDays      Int                    @default(2) @map("deadline_soon_days")
  eveningStart          String                 @default("18:00") @map("evening_start")
  achievementScore      Int                    @default(0) @map("achievement_score")
  achievementsEnabled   Boolean                @default(true) @map("achievements_enabled")
  totpSecret            String?                @map("totp_secret")
  totpEnabled           Boolean                @default(false) @map("totp_enabled")
  googleRefreshToken    String?                @map("google_refresh_token")
  googleStatus String @default("disconnected") @map("google_status")
  googleAccountEmail    String?                @map("google_account_email")
  taskCompleteChildren  CompleteChildrenPolicy @default(ask) @map("task_complete_children")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(6)

  focusSettings         FocusSettings?
  folders               Folder[]
  projects              Project[]
  columns               Column[]
  tags                  Tag[]
  ownedTasks            Task[]                 @relation("TaskOwner")
  createdTasks          Task[]                 @relation("TaskCreatedBy")
  assignedTasks         Task[]                 @relation("TaskAssignee")
  checklistItems        ChecklistItem[]
  smartLists            SmartList[]
  filters               Filter[]
  reminders             Reminder[]
  habits                Habit[]
  habitLogs             HabitLog[]
  focusSessions         FocusSession[]
  stickyNotes           StickyNote[]
  calendarSubscriptions CalendarSubscription[]
  externalEvents        ExternalEvent[]
  taskLinks             TaskLink[]
  attachments           Attachment[]           @relation("AttachmentOwner")
  uploadedAttachments   Attachment[]           @relation("AttachmentUploadedBy")
  comments              Comment[]              @relation("CommentOwner")
  authoredComments      Comment[]              @relation("CommentAuthor")
  activityAsActor       ActivityLog[]          @relation("ActivityActor")
  activityOwned         ActivityLog[]          @relation("ActivityOwner")
  countdowns            Countdown[]
  templates             Template[]
  dashboardLayouts      DashboardLayout[]
  weeklyReports         WeeklyReport[]
  outboxEvents          OutboxEvent[]
  idempotencyRecords    IdempotencyRecord[]
  personalAccessTokens  PersonalAccessToken[]
  reminderDeliveries    ReminderDelivery[]
  pushSubscriptions     PushSubscription[]
  seriesAdvances        SeriesAdvance[]
  sessions              Session[]
  oauthClients          OauthClient[]
  oauthCodes            OauthAuthorizationCode[]
  oauthRefreshTokens    OauthRefreshToken[]
  matrixRules           MatrixRule[]
  calendarFeeds         CalendarFeed[]
  webhookEndpoints      WebhookEndpoint[]
  automations           Automation[]
  ownedMemberships      ProjectMember[]        @relation("MembershipOwner")
  memberships           ProjectMember[]        @relation("MemberUser")
  presences             ListPresence[]
  plugins               PluginInstall[]
  recoveryCodes         RecoveryCode[]
  notificationPreferences NotificationPreference[]
  notificationReceipts NotificationReceipt[]
  notificationActions NotificationAction[]
  telegramLinks         TelegramLink[]
  dayPlans              DayPlan[]
  planSessions          PlanSession[]
  planOperations        PlanOperation[]
  tickyAuthority        TickyAuthority?
  tickyProposals        TickyProposal[]
  tickyLedger           TickyActionLedger[]
  tickyThreads          TickyThread[]
  tickyMessages         TickyClientMessage[]
  tickyMemories         TickyMemory[]
  tickyRoutines         TickyRoutine[]
  telegramPairings      TelegramPairing[]
  telegramCallbacks     TelegramCallback[]

  @@map("users")
}

model FocusSettings {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pomodoroMinutes       Int       @default(25) @map("pomodoro_minutes")
  shortBreakMinutes     Int       @default(5) @map("short_break_minutes")
  longBreakMinutes      Int       @default(15) @map("long_break_minutes")
  cyclesBeforeLongBreak Int       @default(4) @map("cycles_before_long_break")
  autoStartBreaks       Boolean   @default(false) @map("auto_start_breaks")
  autoStartFocus        Boolean   @default(false) @map("auto_start_focus")
  alarmSound            String    @default("bell") @map("alarm_sound")
  volume                Int       @default(70)
  ambientSound          String    @default("none") @map("ambient_sound")
  dailyGoal             Int       @default(8) @map("daily_goal")
  ambientSounds         Json      @default("[]") @map("ambient_sounds")
  strictMode            Boolean   @default(false) @map("strict_mode")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("focus_settings")
}

model Folder {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name      String
  sortOrder BigInt    @default(65536) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  projects  Project[]

  @@index([ownerId, sortOrder])
  @@map("folders")
}

model Project {
  id        String          @id @default(uuid()) @db.Uuid
  ownerId   String          @map("owner_id") @db.Uuid
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name      String
  color     String?
  folderId  String?         @map("folder_id") @db.Uuid
  folder    Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  viewMode  ProjectViewMode @default(list) @map("view_mode")
  kind      ProjectKind     @default(TASK)
  closed    Boolean         @default(false)
  isInbox                Boolean         @default(false) @map("is_inbox")
  defaultReminderTrigger String?         @map("default_reminder_trigger")
  sortOrder              BigInt          @default(65536) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(6)
  columns   Column[]
  tasks     Task[]
  members   ProjectMember[]
  feeds     CalendarFeed[]
  presences ListPresence[]

  @@index([ownerId, sortOrder])
  @@index([ownerId, deletedAt], map: "projects_owner_deleted_idx")
  @@map("projects")
}

model Column {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  projectId String    @map("project_id") @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  collapsed Boolean   @default(false)
  wipLimit  Int?      @map("wip_limit")
  sortOrder BigInt    @default(65536) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tasks     Task[]

  @@index([projectId, sortOrder])
  @@map("columns")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name      String    @db.Citext
  color     String?
  parentId  String?   @map("parent_id") @db.Uuid
  parent    Tag?      @relation("TagTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Tag[]     @relation("TagTree")
  sortOrder BigInt    @default(65536) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tasks     TaskTag[]

  @@unique([ownerId, name])
  @@index([ownerId, sortOrder])
  @@index([ownerId, deletedAt], map: "tags_owner_deleted_idx")
  @@map("tags")
}

model Task {
  id              String                   @id @default(uuid()) @db.Uuid
  ownerId         String                   @map("owner_id") @db.Uuid
  owner           User                     @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  projectId       String                   @map("project_id") @db.Uuid
  project         Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parentId        String?                  @map("parent_id") @db.Uuid
  parent          Task?                    @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Task[]                   @relation("TaskTree")
  columnId        String?                  @map("column_id") @db.Uuid
  column          Column?                  @relation(fields: [columnId], references: [id], onDelete: SetNull)
  title           String                   @db.VarChar(500)
  content         String                   @default("") @db.Text
  kind            TaskKind                 @default(task)
  status          TaskStatus               @default(active)
  priority        Priority                 @default(none)
  isAllDay        Boolean                  @default(false) @map("is_all_day")
  startDate       DateTime?                @map("start_date") @db.Timestamptz(6)
  dueDate         DateTime?                @map("due_date") @db.Timestamptz(6)
  timeZone        String                   @default("Europe/Madrid") @map("time_zone")
  durationMinutes Int?                     @map("duration_minutes")
  isSomeday       Boolean                  @default(false) @map("is_someday")
  eveningOnly     Boolean                  @default(false) @map("evening_only")
  repeatRule      String?                  @map("repeat_rule")
  repeatFrom      RepeatFrom               @default(due_date) @map("repeat_from")
  seriesId        String?                  @map("series_id") @db.Uuid
  recurrenceOpen  Boolean                  @default(true) @map("recurrence_open")
  sortOrder       BigInt                   @default(65536) @map("sort_order")
  assigneeId      String?                  @map("assignee_id") @db.Uuid
  assignee        User?                    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById     String                   @map("created_by") @db.Uuid
  createdBy       User                     @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  completedAt     DateTime?                @map("completed_at") @db.Timestamptz(6)
  source             TaskSource               @default(manual)
  estimatedPomodoros Int?                  @map("estimated_pomodoros")
  metadata           Json                     @default("{}")
  fieldClocks     Json                     @default("{}") @map("field_clocks")
  version         Int                      @default(1)
  searchVector    Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, (((COALESCE(title, ''::character varying))::text || ' '::text) || COALESCE(content, ''::text)))")) @map("search_vector")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz(6)

  tags           TaskTag[]
  checklist      ChecklistItem[]
  reminders      Reminder[]
  deliveries     ReminderDelivery[]
  seriesAdvances SeriesAdvance[]    @relation("SeriesAdvanceSource")
  links          TaskLink[]
  attachments    Attachment[]
  comments       Comment[]
  focusSessions  FocusSession[]
  stickyNotes    StickyNote[]
  planMembers    PlanMember[]

  @@index([projectId, status, sortOrder], map: "tasks_project_status_sort_idx")
  @@index([dueDate], map: "tasks_due_date_idx")
  @@index([seriesId, status], map: "tasks_series_status_idx")
  @@index([ownerId, status, deletedAt, dueDate], map: "tasks_owner_status_deleted_due_idx")
  @@index([ownerId, status, deletedAt, isSomeday], map: "tasks_owner_someday_idx")
  @@index([ownerId, deletedAt, createdAt], map: "tasks_owner_deleted_created_idx")
  @@index([ownerId, parentId, deletedAt], map: "tasks_owner_parent_deleted_idx")
  @@index([searchVector], type: Gin, map: "tasks_fts_idx")
  @@map("tasks")
}

model TaskTag {
  taskId String @map("task_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId], map: "task_tags_tag_id_idx")
  @@map("task_tags")
}

model ChecklistItem {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @map("owner_id") @db.Uuid
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  taskId      String          @map("task_id") @db.Uuid
  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  status      ChecklistStatus @default(active)
  sortOrder   BigInt          @default(65536) @map("sort_order")
  startDate   DateTime?       @map("start_date") @db.Timestamptz(6)
  dueDate     DateTime?       @map("due_date") @db.Timestamptz(6)
  isAllDay    Boolean         @default(false) @map("is_all_day")
  timeZone    String          @default("Europe/Madrid") @map("time_zone")
  completedAt DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(6)

  @@index([taskId, sortOrder])
  @@map("checklist_items")
}

model SmartList {
  id        String       @id @default(uuid()) @db.Uuid
  ownerId   String       @map("owner_id") @db.Uuid
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  key       SmartListKey
  enabled   Boolean      @default(true)
  sortOrder BigInt       @default(65536) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)

  @@unique([ownerId, key])
  @@map("smart_lists")
}

model Filter {
  id        String     @id @default(uuid()) @db.Uuid
  ownerId   String     @map("owner_id") @db.Uuid
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name      String
  icon      String?
  color     String?
  mode      FilterMode @default(normal)
  rules     Json
  sortOrder BigInt     @default(65536) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)

  @@index([ownerId, sortOrder])
  @@map("filters")
}

model Reminder {
  id                      String             @id @default(uuid()) @db.Uuid
  ownerId                 String             @map("owner_id") @db.Uuid
  owner                   User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  taskId                  String             @map("task_id") @db.Uuid
  task                    Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  trigger                 String
  absoluteAt              DateTime?          @map("absolute_at") @db.Timestamptz(6)
  type                    ReminderType
  location                Json?
  channel                 ReminderChannel    @default(push)
  constant                Boolean            @default(false)
  constantIntervalMinutes Int?               @map("constant_interval_minutes")
  snoozedUntil            DateTime?          @map("snoozed_until") @db.Timestamptz(6)
  deliveries              ReminderDelivery[]
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?          @map("deleted_at") @db.Timestamptz(6)

  @@index([taskId])
  @@map("reminders")
}

model Habit {
  id             String     @id @default(uuid()) @db.Uuid
  ownerId        String     @map("owner_id") @db.Uuid
  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name           String
  icon           String?
  color          String?
  goal           Json
  frequency      Json
  reminderTime   String?    @map("reminder_time")
  motivationNote String?    @map("motivation_note")
  archived       Boolean    @default(false)
  sortOrder      BigInt     @default(65536) @map("sort_order")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)
  logs           HabitLog[]

  @@index([ownerId, sortOrder])
  @@map("habits")
}

model HabitLog {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  habitId   String    @map("habit_id") @db.Uuid
  habit     Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  count     Int       @default(1)
  note      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([habitId, date])
  @@map("habit_logs")
}

model FocusSession {
  id               String           @id @default(uuid()) @db.Uuid
  ownerId          String           @map("owner_id") @db.Uuid
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  taskId           String?          @map("task_id") @db.Uuid
  task             Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  type             FocusSessionType
  plannedMinutes   Int              @map("planned_minutes")
  actualSeconds    Int              @default(0) @map("actual_seconds")
  startedAt        DateTime         @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime?        @map("ended_at") @db.Timestamptz(6)
  completed        Boolean          @default(false)
  ambientSound     String?          @map("ambient_sound")
  pausedAt         DateTime?        @map("paused_at") @db.Timestamptz(6)
  pausedSeconds    Int              @default(0) @map("paused_seconds")
  interruptedCount Int              @default(0) @map("interrupted_count")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)

  @@index([ownerId, startedAt])
  @@map("focus_sessions")
}

model StickyNote {
  id           String    @id @default(uuid()) @db.Uuid
  ownerId      String    @map("owner_id") @db.Uuid
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  text         String    @db.Text
  color        String?
  pinnedTaskId String?   @map("pinned_task_id") @db.Uuid
  pinnedTask   Task?     @relation(fields: [pinnedTaskId], references: [id], onDelete: SetNull)
  position     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("sticky_notes")
}

model CalendarSubscription {
  id            String                @id @default(uuid()) @db.Uuid
  ownerId       String                @map("owner_id") @db.Uuid
  owner         User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  url           String?
  provider      String?
  /// Real Google calendar id (RF-2502). Null for iCal and for the legacy two-way push row.
  calendarId    String?               @map("calendar_id")
  summary       String?
  visible       Boolean               @default(true)
  syncDirection CalendarSyncDirection @default(read) @map("sync_direction")
  color         String?
  /// Incremental sync cursor (RF-2510). Not a credential.
  syncToken     String?               @map("sync_token")
  lastSyncedAt  DateTime?             @map("last_synced_at") @db.Timestamptz(6)
  lastError     String?               @map("last_error")
  /// Consecutive sync failures. After 3, retryAfter holds the one-hour backoff (RF-2513).
  syncFailures  Int                   @default(0) @map("sync_failures")
  retryAfter    DateTime?             @map("retry_after") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?             @map("deleted_at") @db.Timestamptz(6)
  events        ExternalEvent[]

  @@index([ownerId])
  @@map("calendar_subscriptions")
}

model ExternalEvent {
  id             String               @id @default(uuid()) @db.Uuid
  ownerId        String               @map("owner_id") @db.Uuid
  owner          User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  subscriptionId String               @map("subscription_id") @db.Uuid
  subscription   CalendarSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  externalUid    String               @map("external_uid")
  title          String
  startsAt       DateTime             @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime?            @map("ends_at") @db.Timestamptz(6)
  isAllDay       Boolean              @default(false) @map("is_all_day")
  timeZone       String               @default("Europe/Madrid") @map("time_zone")
  status         String               @default("confirmed")
  raw            Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(6)

  @@unique([subscriptionId, externalUid])
  @@index([ownerId, startsAt])
  @@map("external_events")
}

model Attachment {
  id           String    @id @default(uuid()) @db.Uuid
  ownerId      String    @map("owner_id") @db.Uuid
  owner        User      @relation("AttachmentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  taskId       String    @map("task_id") @db.Uuid
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  byteSize BigInt @map("byte_size")
  driveFileId String @map("drive_file_id")
  iconLink String? @map("icon_link")
  driveFolderId String? @map("drive_folder_id")
  source String @default("legacy")
  webViewLink  String    @map("web_view_link")
  uploadedById String    @map("uploaded_by") @db.Uuid
  uploadedBy   User      @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([taskId, driveFileId])
  @@index([taskId])
  @@map("attachments")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation("CommentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  taskId    String    @map("task_id") @db.Uuid
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String    @map("author_id") @db.Uuid
  author    User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body      String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([taskId, createdAt])
  @@map("comments")
}

model ActivityLog {
  id         String               @id @default(uuid()) @db.Uuid
  ownerId    String               @map("owner_id") @db.Uuid
  owner      User                 @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  actorId    String               @map("actor_id") @db.Uuid
  actor      User                 @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  tokenId    String?              @map("token_id") @db.Uuid
  token      PersonalAccessToken? @relation(fields: [tokenId], references: [id], onDelete: Restrict)
  entityType String               @map("entity_type")
  entityId   String               @map("entity_id") @db.Uuid
  action     ActivityAction
  changes    Json                 @default("{}")
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?            @map("deleted_at") @db.Timestamptz(6)

  @@index([ownerId, createdAt])
  @@index([entityType, entityId])
  @@index([tokenId, createdAt])
  @@map("activity_log")
}

// PAT (RF-2002). Only the hash is stored. Revocation is immediate via revoked_at.
model PersonalAccessToken {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name        String
  tokenHash   String    @unique @map("token_hash")
  tokenPrefix String    @map("token_prefix")
  scopes      String[]
  listRestricted Boolean @default(false) @map("list_restricted")
  listIds     String[]  @default([]) @map("list_ids")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  oauthClientId String? @map("oauth_client_id") @db.Uuid
  oauthClient OauthClient? @relation(fields: [oauthClientId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  activity       ActivityLog[]
  memberships    ProjectMember[]
  refreshTokens  OauthRefreshToken[]

  @@index([ownerId, createdAt])
  @@index([oauthClientId])
  @@map("personal_access_tokens")
}

// Transactional outbox (section 11). Drained by the bus; not a section 5 entity.
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  type        String
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorKind   String    @map("actor_kind")
  actorId     String    @map("actor_id") @db.Uuid
  data        Json
  previous    Json?
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([publishedAt, occurredAt])
  @@index([ownerId, occurredAt])
  @@map("outbox_events")
}

// Idempotency-Key retention is 24h (section 10.2). Not a section 5 entity.
model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  key          String
  fingerprint  String
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([ownerId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model Countdown {
  id              String            @id @default(uuid()) @db.Uuid
  ownerId         String            @map("owner_id") @db.Uuid
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title           String
  type            CountdownType     @default(countdown)
  emoji           String?
  targetDate      DateTime          @map("target_date") @db.Date
  repeatRule      CountdownRepeat   @default(none) @map("repeat_rule")
  dayMode         CountdownDayMode  @default(standard) @map("day_mode")
  color           String?
  style           String?
  notes           String?
  showInSidebar   Boolean           @default(true) @map("show_in_sidebar")
  showInSmartList Boolean           @default(true) @map("show_in_smart_list")
  pinned          Boolean           @default(false)
  sortOrder       Int               @default(0) @map("sort_order")
  archivedAt      DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)
  reminders       CountdownReminder[]
  deliveries      ReminderDelivery[] @relation("CountdownDelivery")

  @@index([ownerId])
  @@index([targetDate])
  @@map("countdowns")
}

model CountdownReminder {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countdownId String    @map("countdown_id") @db.Uuid
  countdown   Countdown @relation(fields: [countdownId], references: [id], onDelete: Cascade)
  deliveries  ReminderDelivery[]
  offsetDays  Int       @map("offset_days")
  constant    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([countdownId, offsetDays, constant])
  @@map("countdown_reminders")
}

model Template {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name      String
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([ownerId])
  @@map("templates")
}

model DashboardLayout {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name      String
  widgets   Json
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([ownerId])
  @@map("dashboard_layouts")
}

model WeeklyReport {
  id                String    @id @default(uuid()) @db.Uuid
  ownerId           String    @map("owner_id") @db.Uuid
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  weekStart         DateTime  @map("week_start") @db.Date
  payload           Json
  tone              String
  deliveredChannels Json      @default("[]") @map("delivered_channels")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([ownerId, weekStart])
  @@map("weekly_reports")
}

// Operational queue for RF-808. Not a soft-deleted domain entity: rows are the
// persistent schedule until they are fired or marked late.
model ReminderDelivery {
  id         String                 @id @default(uuid()) @db.Uuid
  ownerId    String                 @map("owner_id") @db.Uuid
  owner      User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reminderId String?                @map("reminder_id") @db.Uuid
  reminder   Reminder?              @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  taskId     String?                @map("task_id") @db.Uuid
  task       Task?                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  countdownId String?               @map("countdown_id") @db.Uuid
  countdown   Countdown?            @relation("CountdownDelivery", fields: [countdownId], references: [id], onDelete: Cascade)
  countdownReminderId String?       @map("countdown_reminder_id") @db.Uuid
  countdownReminder CountdownReminder? @relation(fields: [countdownReminderId], references: [id], onDelete: Cascade)
  notificationReceipts NotificationReceipt[]
  notificationActions NotificationAction[]
  dedupeKey  String                 @unique @map("dedupe_key")
  fireAt     DateTime               @map("fire_at") @db.Timestamptz(6)
  channel    ReminderChannel        @default(push)
  status     ReminderDeliveryStatus @default(scheduled)
  kind       ReminderDeliveryKind
  payload    Json                   @default("{}")
  firedAt    DateTime?              @map("fired_at") @db.Timestamptz(6)
  attempts   Int                    @default(0)
  nextRetryAt DateTime?             @map("next_retry_at") @db.Timestamptz(6)
  leaseUntil DateTime?              @map("lease_until") @db.Timestamptz(6)
  leaseOwner String?                @map("lease_owner")
  fenceGeneration Int               @default(0) @map("fence_generation")
  channelState Json                 @default("{}") @map("channel_state")
  telegramMessageId String?         @map("telegram_message_id")
  reconcileRequired Boolean         @default(false) @map("reconcile_required")
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, fireAt])
  @@index([status, nextRetryAt])
  @@map("reminder_deliveries")
  @@index([countdownId])
}

model PushSubscription {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([ownerId, endpoint])
  @@map("push_subscriptions")
}

// Written when the current occurrence is detached. The scheduler is the only
// reader that turns this into the next series task.
model SeriesAdvance {
  id           String     @id @default(uuid()) @db.Uuid
  ownerId      String     @map("owner_id") @db.Uuid
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  seriesId     String     @map("series_id") @db.Uuid
  sourceTaskId String     @map("source_task_id") @db.Uuid
  sourceTask   Task       @relation("SeriesAdvanceSource", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  repeatRule   String     @map("repeat_rule")
  repeatFrom   RepeatFrom @map("repeat_from")
  timeZone     String     @map("time_zone")
  isAllDay     Boolean    @map("is_all_day")
  dueDate      DateTime?  @map("due_date") @db.Timestamptz(6)
  startDate    DateTime?  @map("start_date") @db.Timestamptz(6)
  processedAt  DateTime?  @map("processed_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([processedAt])
  @@map("series_advances")
}

// Browser session (section 10.1). The cookie stores the secret; only the hash is kept.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  csrfToken  String    @map("csrf_token")
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("sessions")
}

// Public OAuth client for Authorization Code + PKCE (section 10.1). No client secret.
// Dynamic registration leaves owner empty until a person consents.
model OauthClient {
  id           String    @id @default(uuid()) @db.Uuid
  ownerId      String?   @map("owner_id") @db.Uuid
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  redirectUris String[]  @map("redirect_uris")
  dynamic      Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  codes        OauthAuthorizationCode[]
  accessTokens PersonalAccessToken[]
  refreshTokens OauthRefreshToken[]

  @@index([ownerId])
  @@map("oauth_clients")
}

model OauthAuthorizationCode {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  client        OauthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash      String    @unique @map("code_hash")
  codeChallenge String    @map("code_challenge")
  scopes        String[]
  redirectUri   String    @map("redirect_uri")
  resource      String?
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("oauth_authorization_codes")
}

// Opaque refresh token. Only the hash is stored. Rotation detects reuse of a spent token.
model OauthRefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  client        OauthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenId String    @map("access_token_id") @db.Uuid
  accessToken   PersonalAccessToken @relation(fields: [accessTokenId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  replacementPair String? @map("replacement_pair")
  replacementAccessId String? @map("replacement_access_id") @db.Uuid
  rotatedAt     DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([familyId])
  @@index([userId])
  @@index([accessTokenId])
  @@map("oauth_refresh_tokens")
}

/// RF-1004. Null rules mean the default urgent/important split.
model MatrixRule {
  id        String         @id @default(uuid()) @db.Uuid
  ownerId   String         @map("owner_id") @db.Uuid
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  quadrant  MatrixQuadrant
  rules     Json?
  effect    Json
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(6)

  @@unique([ownerId, quadrant])
  @@map("matrix_rules")
}

/// RF-1104. Only the hash of the secret URL is stored.
model CalendarFeed {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  projectId  String?   @map("project_id") @db.Uuid
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filterId   String?   @map("filter_id") @db.Uuid
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([ownerId])
  @@map("calendar_feeds")
}

model WebhookEndpoint {
  id        String            @id @default(uuid()) @db.Uuid
  ownerId   String            @map("owner_id") @db.Uuid
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String[]
  active    Boolean           @default(true)
  deliveries WebhookDelivery[]
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?         @map("deleted_at") @db.Timestamptz(6)

  @@index([ownerId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String               @id @default(uuid()) @db.Uuid
  endpointId  String               @map("endpoint_id") @db.Uuid
  endpoint    WebhookEndpoint      @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId     String               @map("event_id") @db.Uuid
  eventType   String               @map("event_type")
  state       WebhookDeliveryState @default(pending)
  attempts    Int                  @default(0)
  lastStatus  Int?                 @map("last_status")
  nextAttempt DateTime?            @map("next_attempt") @db.Timestamptz(6)
