/// Ticky authority for one owner. Version only increases. Shared lists are not grants.
model TickyAuthority {
  id                       String           @id @default(uuid()) @db.Uuid
  ownerId                  String           @unique @map("owner_id") @db.Uuid
  owner                    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  version                  Int              @default(1)
  autonomy                 Int              @default(0)
  revoked                  Boolean          @default(false)
  paused                   Boolean          @default(false)
  inboxListId              String?          @map("inbox_list_id") @db.Uuid
  readEnabled              Boolean          @default(false) @map("read_enabled")
  estimateLearningEnabled  Boolean          @default(false) @map("estimate_learning_enabled")
  coachingSilence          Json?            @map("coaching_silence")
  reminderSilence          Json?            @map("reminder_silence")
  workdayStart             String?          @map("workday_start")
  workdayEnd               String?          @map("workday_end")
  sourceRevision           Int              @default(1) @map("source_revision")
  actionScopes             String[]         @default([]) @map("action_scopes")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  lists                    TickyListGrant[]

  @@map("ticky_authorities")
}

