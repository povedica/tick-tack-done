/// RF-1801. A member is a user or a personal access token. The list still has one owner.
model ProjectMember {
  id         String              @id @default(uuid()) @db.Uuid
  ownerId    String              @map("owner_id") @db.Uuid
  owner      User                @relation("MembershipOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  projectId  String              @map("project_id") @db.Uuid
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId   String?             @map("member_id") @db.Uuid
  member     User?               @relation("MemberUser", fields: [memberId], references: [id], onDelete: Cascade)
  tokenId    String?             @map("token_id") @db.Uuid
  token      PersonalAccessToken? @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  permission SharePermission
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?           @map("deleted_at") @db.Timestamptz(6)

  @@index([projectId])
  @@index([memberId])
  @@map("project_members")
}

