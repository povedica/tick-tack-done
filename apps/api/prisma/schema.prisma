// Operational queue for RF-808. Not a soft-deleted domain entity: rows are the
// persistent schedule until they are fired or marked late.
model ReminderDelivery {
  id         String                 @id @default(uuid()) @db.Uuid
  ownerId    String                 @map("owner_id") @db.Uuid
  owner      User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reminderId String?                @map("reminder_id") @db.Uuid
  reminder   Reminder?              @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  taskId     String?                @map("task_id") @db.Uuid
  task       Task?                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  dedupeKey  String                 @unique @map("dedupe_key")
  fireAt     DateTime               @map("fire_at") @db.Timestamptz(6)
  channel    ReminderChannel        @default(push)
  status     ReminderDeliveryStatus @default(scheduled)
  kind       ReminderDeliveryKind
  payload    Json                   @default("{}")
  firedAt    DateTime?              @map("fired_at") @db.Timestamptz(6)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, fireAt])
  @@map("reminder_deliveries")
}

model PushSubscription {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  endpoint  String
