    .danger { color:#ff8787 !important; }
    .border { border-color:#333333 !important; }
    .chip { background-color:#2f3a5c !important; color:#c5d4ff !important; }
    .note { background-color:#2a2a2a !important; border-color:#3a3a3a !important; }
    .bar-none { background-color:#4a4a4a !important; }
    .placeholder { border-color:#4a4a4a !important; color:#a8a8a8 !important; }
  }
  [data-ogsc] .ink { color:#ffffff !important; }
  [data-ogsc] .ink2 { color:#a8a8a8 !important; }
  [data-ogsc] .accink { color:#c5d4ff !important; }
</style>
</head>
<body class="bg" style="margin:0;padding:0;background-color:#f2f5fe;">
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">Hoy, 25 nov · 10:00 · Casa · Preguntar por el presupuesto del calentador.&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg" bgcolor="#f2f5fe" style="background-color:#f2f5fe;">
<tr><td align="center" class="outer" style="padding:24px 12px;">
<!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="container" style="width:600px;max-width:600px;">
<tr><td class="px" style="padding:4px 8px 16px 8px;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
<td width="40" height="40" align="center" valign="middle" bgcolor="#4772FA" style="width:40px;height:40px;background-color:#4772FA;border-radius:10px;font-size:0;line-height:0;"><img src="https://todo.reflexionia.com/apple-touch-icon.png" width="32" height="32" alt="" border="0" style="display:block;width:32px;height:32px;border:0;outline:none;text-decoration:none;"></td>
<td class="ink" style="padding-left:10px;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:18px;font-weight:600;color:#191919;">TickTackDone</td>
</tr></table>
</td></tr>
<tr><td class="surface px" bgcolor="#ffffff" style="background-color:#ffffff;border:1px solid #e6e9f2;border-radius:14px;padding:28px 32px;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#191919;">
<p class="accink" style="margin:0 0 4px 0;font-size:13px;line-height:18px;color:#3e60cd;font-weight:700;text-transform:uppercase;letter-spacing:0.4px;">Recordatorio</p>
<h1 class="h1" style="margin:0 0 16px 0;font-size:24px;line-height:30px;font-weight:700;"><a href="https://todo.reflexionia.com/task/t_demo09" class="ink" style="color:#191919;text-decoration:none;">Llamar al fontanero</a></h1>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="ink2 border" width="96" valign="top" style="width:96px;padding:10px 8px 10px 0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b6b6b;">Cuándo</td><td class="ink border" valign="top" style="padding:10px 0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;color:#191919;"><strong>Hoy, 25 nov · 10:00</strong></td></tr><tr><td class="ink2 border" width="96" valign="top" style="width:96px;border-top:1px solid #e6e9f2;padding:10px 8px 10px 0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b6b6b;">Lista</td><td class="ink border" valign="top" style="border-top:1px solid #e6e9f2;padding:10px 0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;color:#191919;">Casa</td></tr><tr><td class="ink2 border" width="96" valign="top" style="width:96px;border-top:1px solid #e6e9f2;padding:10px 8px 10px 0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b6b6b;">Prioridad</td><td class="ink border" valign="top" style="border-top:1px solid #e6e9f2;padding:10px 0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;color:#191919;"><span style="color:#e13e39;font-size:12px;">&#9650;</span><span class="ink" style="color:#191919;"> Alta</span></td></tr><tr><td class="ink2 border" width="96" valign="top" style="width:96px;border-top:1px solid #e6e9f2;padding:10px 8px 10px 0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#6b6b6b;">Etiquetas</td><td class="ink border" valign="top" style="border-top:1px solid #e6e9f2;padding:10px 0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;color:#191919;"><span class="chip" style="display:inline-block;background-color:#ecf0fe;color:#3e60cd;font-size:12px;line-height:18px;font-weight:600;padding:1px 8px;border-radius:9px;margin:4px 4px 0 0;">casa</span><span class="chip" style="display:inline-block;background-color:#ecf0fe;color:#3e60cd;font-size:12px;line-height:18px;font-weight:600;padding:1px 8px;border-radius:9px;margin:4px 4px 0 0;">llamadas</span></td></tr></table>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px;"><tr><td class="note" bgcolor="#f7f8fb" style="background-color:#f7f8fb;border:1px solid #e6e9f2;border-radius:10px;padding:12px 14px;font-size:14px;line-height:21px;"><span class="ink2" style="color:#6b6b6b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.4px;">Nota</span><br><span class="ink" style="color:#191919;">Preguntar por el presupuesto del calentador.</span></td></tr></table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="btn-wrap" style="margin-top:24px;"><tr><td class="btn" align="center" bgcolor="#3e60cd" style="background-color:#3e60cd;border-radius:10px;"><!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="https://todo.reflexionia.com/task/t_demo09" style="height:44px;v-text-anchor:middle;width:160px;" arcsize="20%" fillcolor="#3e60cd" stroke="f"><center style="color:#ffffff;font-family:Segoe UI,Arial,sans-serif;font-size:15px;font-weight:bold;">Ver tarea</center></v:roundrect><![endif]--><!--[if !mso]><!-- --><a href="https://todo.reflexionia.com/task/t_demo09" style="display:inline-block;padding:12px 24px;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:10px;">Ver tarea</a><!--<![endif]--></td></tr></table>
</td></tr>
