{
  "name": "api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm --filter @reflexionia/domain build && nest build",
    "start": "node dist/main.js",
    "lint": "eslint src test --no-error-on-unmatched-pattern",
    "typecheck": "pnpm --filter @reflexionia/domain build && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "pnpm build && vitest run --config vitest.config.integration.ts",
    "openapi:generate": "node dist/scripts/generate-openapi.js && node ../../scripts/generate-mcp-catalog.mjs",
    "seed": "tsx prisma/seed.ts",
    "prisma": "prisma",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/client": "^6.0.0",
    "@reflexionia/domain": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^5.0.0",
    "busboy": "1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "date-fns-tz": "^3.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "multer": "2.4.0",
    "nodemailer": "^10.0.6",
    "reflect-metadata": "^0.2.2",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@types/busboy": "1.5.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "3.6.4",
    "eslint": "9.17.0",
    "express": "^5.3.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
