{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "composite": true,
    "declaration": true,
    "useDefineForClassFields": true,
    "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src", "e2e"]
}
