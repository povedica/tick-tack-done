{
  "name": "reflexionia-tasks",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Gestor de tareas personal extensible - todo.reflexionia.com",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up -d && pnpm -r --parallel dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter @reflexionia/domain build && pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @reflexionia/domain build && pnpm -r typecheck",
    "test": "pnpm --filter @reflexionia/domain build && pnpm -r test",
    "test:integration": "pnpm --filter api test:integration",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:migrate": "bash scripts/with-env.sh pnpm --filter api exec prisma migrate dev",
    "db:deploy": "bash scripts/with-env.sh pnpm --filter api exec prisma migrate deploy",
    "db:seed": "bash scripts/with-env.sh pnpm --filter api seed",
    "backup": "bash scripts/backup.sh",
    "backup:verify": "bash scripts/restore-verify.sh"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "js-yaml": "^4.1.1",
      "nodemailer": "^10.0.6",
      "ora": "5.4.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.9.10",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.2"
  }
}
