# Crontab del usuario deploy en el host compartido (checkout /opt/todo/app).
# 0 4 * * * backup diario. 0 5 * * 0 prueba de restauración.
0 4 * * * /opt/todo/app/deploy/production/cron-backup.sh >> /opt/todo/backups/backup.log 2>&1
0 5 * * 0 /opt/todo/app/deploy/production/cron-restore-verify.sh >> /opt/todo/backups/restore.log 2>&1
