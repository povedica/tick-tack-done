# Imported by the edge Caddy that already listens on 80/443.
# This file does not open ports. Connect that Caddy to the EDGE_NETWORK used by this stack.
# Default site address is production; override with SITE_ADDRESS for other hosts.
{$SITE_ADDRESS:todo.reflexionia.com} {
	encode zstd gzip

	@docs path /api/docs*
	handle @docs {
		respond 404
	}

	handle /api/* {
		request_body {
			max_size 26MB
		}
		reverse_proxy todo-api:3000
	}

	handle /feeds/* {
		reverse_proxy todo-api:3000
	}

	handle /open/* {
		reverse_proxy todo-api:3000
	}

	# OAuth discovery (RFC 9728 / RFC 8414). Must run before the SPA fallback.
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy todo-api:3000
	}

	handle /.well-known/oauth-authorization-server* {
		reverse_proxy todo-api:3000
	}

	# OIDC discovery is not implemented; never return the SPA HTML shell.
	handle /.well-known/openid-configuration* {
		header Content-Type application/json
		respond `{"error":{"code":"not_found","message":"OpenID Connect discovery is not supported"}}` 404
	}

	handle /oauth/authorize {
		reverse_proxy todo-api:3000
	}

	handle /oauth/token {
		reverse_proxy todo-api:3000
	}

	handle /oauth/register {
		reverse_proxy todo-api:3000
	}

	handle /oauth/revoke {
		reverse_proxy todo-api:3000
	}

	handle /manifest.json {
		redir /manifest.webmanifest 308
	}

	handle {
		reverse_proxy todo-web:8080
	}

	header {
		+Vary "Accept-Encoding"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		Permissions-Policy "camera=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}
