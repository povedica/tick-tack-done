+export function HabitStepper({
+  value,
+  min = 1,
+  max,
+  label,
+  onChange,
+}: {
+  readonly value: number;
+  readonly min?: number;
+  readonly max: number;
+  readonly label: string;
+  readonly onChange: (value: number) => void;
+}) {
+  return (
+    <div className="habit-stepper" role="group" aria-label={label}>
+      <Button
+        variant="ghost"
+        type="button"
+        aria-label={`− ${label}`}
+        disabled={value <= min}
+        onClick={() => {
+          onChange(Math.max(min, value - 1));
+        }}
+      >
+        <Minus size={16} aria-hidden="true" />
+      </Button>
+      <input
+        type="number"
+        min={min}
+        max={max}
+        aria-label={label}
+        value={value}
+        onChange={(e) => {
+          const n = Number(e.target.value);
+          if (Number.isInteger(n) && n >= min && n <= max) onChange(n);
+        }}
+      />
+      <Button
+        variant="ghost"
+        type="button"
+        aria-label={`+ ${label}`}
+        disabled={value >= max}
+        onClick={() => {
+          onChange(Math.min(max, value + 1));
+        }}
+      >
+        <Plus size={16} aria-hidden="true" />
+      </Button>
+    </div>
+  );
