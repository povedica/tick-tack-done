{
  "tools": [
    {
      "name": "api_catalog",
      "description": "Discover every public API operation and its request schema. Filter by path or summary. Use api_request for operations without a dedicated tool.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string"
          },
          "details": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "api_request",
      "description": "Execute any public API v1 operation with the same bearer token, scopes, owner/list restrictions and validation as REST/UI. Use api_catalog first. For task syntax use quick_add/raw_text. Browser-session-only security operations still require a browser session. Binary responses are base64.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PATCH",
              "PUT",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/api/v1/"
          },
          "body": {
            "type": "object",
            "additionalProperties": true
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 200
          },
          "files": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "filename",
                "base64"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "filename": {
                  "type": "string",
                  "minLength": 1
                },
                "content_type": {
                  "type": "string"
                },
                "base64": {
                  "type": "string",
                  "maxLength": 34952536
                }
              }
            }
          }
        },
        "required": [
          "method",
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_tasks",
      "description": "List tasks. Default status is active. Pass status=completed|cancelled|archived|all to include others. Optional filters: tag_id, priority, from/to (due_date bounds as ISO). someday=true lists Someday; the default excludes them. Workflow columns (pending/in progress) are list board columns via column_id (TTD-AUD-53).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "tag_id": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "string",
            "description": "Lower bound for due_date (ISO 8601)."
          },
          "to": {
            "type": "string",
            "description": "Upper bound for due_date (ISO 8601)."
          },
          "priority": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "someday": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "archived",
              "cancelled",
              "all"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_task",
      "description": "Read one task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_task",
      "description": "Create a task. project_id defaults to the inbox. start_date is when you plan to do it; due_date is the deadline. someday parks it out of Today; evening_only reserves it for this evening. Pass tag_ids or tags (names; missing names are created). content is the description. parse=true runs the same quick-add parser as the app on title (#tag, ^list, !priority, natural dates). To make it REPEAT, pass `recurrence` (structured) — the task needs a due_date, which anchors the series. Examples: 'cada día' = {freq:'daily'}; 'cada lunes y jueves' = {freq:'weekly', weekdays:['MO','TH']}; 'cada 19 de mes' = {freq:'monthly', month_day:19}; 'el último viernes del mes' = {freq:'monthly', month_week:{setpos:-1, weekday:'FR'}}; 'cada día laborable' = {freq:'weekly', weekdays:['MO','TU','WE','TH','FR']}. Default interval is 1; 'cada 3 días' = {freq:'daily', interval:3}. End with until (date) or count (N times). repeat_from:'completion_date' repeats from when it was completed ('regar cada 3 días desde que lo hice'). Advanced: pass a raw RRULE string as repeat_rule instead. One occurrence exists at a time; the next one appears after completing the current (see complete_task).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "parent_id": {
            "type": "string",
            "format": "uuid",
            "description": "Parent task id to create a one-level subtask (TTD-AUD-52)."
          },
          "column_id": {
            "type": "string",
            "format": "uuid",
            "description": "Board column id for workflow (pending / in progress). Prefer this over inventing workflow_state (TTD-AUD-53)."
          },
          "content": {
            "type": "string",
            "maxLength": 100000,
            "description": "Task description (Markdown). Distinct from comments and sticky notes."
          },
          "tag_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 50,
            "description": "Tag UUIDs to assign (replaces the whole set when used on update_task)."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 50,
            "description": "Tag names to assign; missing names are created (same as quick add)."
          },
          "parse": {
            "type": "boolean",
            "description": "If true, parse title with the quick-add parser (same as the capture box). Explicit fields win over the parse."
          },
          "due_date": {
            "type": "string",
            "description": "YYYY-MM-DD = all-day in the task time zone; YYYY-MM-DDTHH:mm±hh:mm = timed instant."
          },
          "start_date": {
            "type": "string",
            "description": "YYYY-MM-DD = all-day in the task time zone; YYYY-MM-DDTHH:mm±hh:mm = timed instant."
          },
          "is_all_day": {
            "type": "boolean"
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "description": "Kept as given. If start_date and due_date are both set within 24h, must match their span."
          },
          "priority": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "someday": {
            "type": "boolean"
          },
          "evening_only": {
            "type": "boolean"
          },
          "recurrence": {
            "type": "object",
            "properties": {
              "freq": {
                "type": "string",
                "enum": [
                  "daily",
                  "weekly",
                  "monthly",
                  "yearly"
                ]
              },
              "interval": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              },
              "weekdays": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "MO",
                    "TU",
                    "WE",
                    "TH",
                    "FR",
                    "SA",
                    "SU"
                  ]
                },
                "description": "Only with freq=weekly."
              },
              "month_day": {
                "type": "integer",
                "minimum": -31,
                "maximum": 31,
                "description": "Only with freq=monthly/yearly. Positive day of month, or negative from month end (-1 = last day)."
              },
              "month_week": {
                "type": "object",
                "properties": {
                  "setpos": {
                    "type": "integer",
                    "enum": [
                      1,
                      2,
                      3,
                      4,
                      -1
                    ],
                    "description": "-1 = last."
                  },
                  "weekday": {
                    "type": "string",
                    "enum": [
                      "MO",
                      "TU",
                      "WE",
                      "TH",
                      "FR",
                      "SA",
                      "SU"
                    ]
                  }
                },
                "required": [
                  "setpos",
                  "weekday"
                ],
                "additionalProperties": false,
                "description": "Only with freq=monthly: last Friday of the month = {setpos:-1, weekday:'FR'}."
              },
              "until": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "End of the series (civil date in the task time zone)."
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "description": "End after N occurrences."
              }
            },
            "required": [
              "freq"
            ],
            "additionalProperties": false
          },
          "repeat_rule": {
            "type": "string",
            "maxLength": 500,
            "description": "Advanced raw RRULE (optionally with DTSTART/EXDATE lines). Mutually exclusive with recurrence."
          },
          "repeat_from": {
            "type": "string",
            "enum": [
              "due_date",
              "completion_date"
            ],
            "description": "due_date (default): next from the rule grid. completion_date: from when you completed it (habits like 'water every 3 days')."
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "quick_add",
      "description": "Capture a task from natural language (same parser as the in-app capture box): #tags, ^list, !priority, dates like «mañana 09:00-09:30».",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "complete_task",
      "description": "Mark a task complete. On a repeating task the next occurrence is created by a scheduler within ~60 s unless materialize_next=true. advance controls the next date: 'one_period' (default, one period after the current due date — an overdue task may repeat in the past) or 'next_future' (first future occurrence; skipped occurrences are gone for good). Use get_task_occurrences to preview.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "advance": {
            "type": "string",
            "enum": [
              "one_period",
              "next_future"
            ],
            "description": "How to pick the next due date for a repeating task. Default 'one_period'."
          },
          "materialize_next": {
            "type": "boolean",
            "description": "If true, create the next occurrence in this same call instead of waiting for the scheduler (~60 s)."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "reopen_task",
      "description": "Reopen a completed task (API uncomplete). Workflow columns are separate from status — use column_id when available (TTD-AUD-53).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
