    {
      "name": "update_task",
      "description": "Update a task. start_date is when you plan to do it; due_date is the deadline and may be cleared without changing when. someday=true clears when and keeps the deadline. tag_ids/tags replace the set; add_tag_ids/add_tags and remove_tag_ids/remove_tags adjust it. content updates the description. column_id sets the board workflow column. parse=true parses the new title like quick add. To change repetition pass recurrence or repeat_rule (same rules as create_task). recurrence:null (or repeat_rule:null) removes the series; changing the rule does not regenerate past occurrences or the series_id unless you clear it. To change list use move_task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100000
          },
          "column_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "tag_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 50,
            "description": "Tag UUIDs to assign (replaces the whole set when used on update_task)."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 50,
            "description": "Tag names to assign; missing names are created (same as quick add)."
          },
          "add_tag_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 50,
            "description": "Tag UUIDs to assign (replaces the whole set when used on update_task)."
          },
          "add_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 50,
            "description": "Tag names to assign; missing names are created (same as quick add)."
          },
          "remove_tag_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 50,
            "description": "Tag UUIDs to assign (replaces the whole set when used on update_task)."
          },
          "remove_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 50,
            "description": "Tag names to assign; missing names are created (same as quick add)."
          },
          "parse": {
            "type": "boolean",
            "description": "If true, parse title with the quick-add parser. Explicit fields win."
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "YYYY-MM-DD = all-day in the task time zone; YYYY-MM-DDTHH:mm±hh:mm = timed instant; null clears."
          },
          "start_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "YYYY-MM-DD = all-day in the task time zone; YYYY-MM-DDTHH:mm±hh:mm = timed instant; null clears."
          },
          "is_all_day": {
            "type": "boolean"
          },
          "duration_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1440,
            "description": "Kept as given. If start_date and due_date are both set within 24h, must match their span."
          },
          "priority": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "someday": {
            "type": "boolean"
          },
          "evening_only": {
            "type": "boolean"
          },
          "recurrence": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "freq": {
                "type": "string",
                "enum": [
                  "daily",
                  "weekly",
                  "monthly",
                  "yearly"
                ]
              },
              "interval": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              },
              "weekdays": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "MO",
                    "TU",
                    "WE",
                    "TH",
                    "FR",
                    "SA",
                    "SU"
                  ]
                },
                "description": "Only with freq=weekly."
              },
              "month_day": {
                "type": "integer",
                "minimum": -31,
                "maximum": 31,
                "description": "Only with freq=monthly/yearly. Positive day of month, or negative from month end (-1 = last day)."
              },
              "month_week": {
                "type": "object",
                "properties": {
                  "setpos": {
                    "type": "integer",
                    "enum": [
                      1,
                      2,
                      3,
                      4,
                      -1
                    ],
                    "description": "-1 = last."
                  },
                  "weekday": {
                    "type": "string",
                    "enum": [
                      "MO",
                      "TU",
                      "WE",
                      "TH",
                      "FR",
                      "SA",
                      "SU"
                    ]
                  }
                },
                "required": [
                  "setpos",
                  "weekday"
                ],
                "additionalProperties": false,
                "description": "Only with freq=monthly: last Friday of the month = {setpos:-1, weekday:'FR'}."
              },
              "until": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "End of the series (civil date in the task time zone)."
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "description": "End after N occurrences."
              }
            },
            "required": [
              "freq"
            ],
            "additionalProperties": false,
            "description": "Structured recurrence, or null to remove the series."
          },
          "repeat_rule": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500,
            "description": "Raw RRULE, or null to clear. Mutually exclusive with recurrence."
          },
          "repeat_from": {
            "type": "string",
            "enum": [
              "due_date",
              "completion_date"
            ],
            "description": "due_date (default): next from the rule grid. completion_date: from when you completed it (habits like 'water every 3 days')."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
